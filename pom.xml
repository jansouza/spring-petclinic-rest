<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.springframework.samples</groupId>
    <artifactId>spring-petclinic-rest</artifactId>
    <version>4.0.2</version>

    <description>REST version of the Spring Petclinic sample application</description>
    <url>https://spring-petclinic.github.io/</url>

    <!-- REMOVED: spring-boot-starter-parent 4.1.1. Replaced by the Quarkus platform BOM (dependencyManagement below).
         The properties and plugin versions that the Spring Boot parent used to provide are now declared explicitly. -->

    <properties>

        <!-- Quarkus platform -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.40.1</quarkus.platform.version>

        <!-- Properties formerly inherited from spring-boot-starter-parent -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler-plugin.version>3.16.0</maven.compiler-plugin.version>
        <maven.surefire-plugin.version>3.6.0</maven.surefire-plugin.version>
        <maven.enforcer-plugin.version>3.6.3</maven.enforcer-plugin.version>
        <maven.build-helper-plugin.version>3.6.2</maven.build-helper-plugin.version>

        <!-- Third-party libraries -->
        <!-- TODO: Migration required - spring-data-jdbc-core (used by the 'jdbc' repository implementation only) has no
             Quarkus Spring-compat equivalent; see the commented dependency below -->
        <spring-data-jdbc.version>1.2.1.RELEASE</spring-data-jdbc.version>
        <swagger-annotations.version>2.2.55</swagger-annotations.version>
        <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <jaxb-api.version>2.3.1</jaxb-api.version>

        <!-- Maven plugins and supporting properties -->
        <maven.checkstyle-plugin.version>3.6.0</maven.checkstyle-plugin.version>
        <maven.exec-plugin.version>3.5.0</maven.exec-plugin.version>
        <maven.jacoco-plugin.version>0.8.15</maven.jacoco-plugin.version>
        <maven.jxr-plugin.version>3.6.0</maven.jxr-plugin.version>
        <maven.license-plugin.version>2.7.1</maven.license-plugin.version>
        <maven.openapi-generator-plugin.version>7.25.0</maven.openapi-generator-plugin.version>
        <maven.project-info-reports-plugin.version>3.9.0</maven.project-info-reports-plugin.version>
        <maven.rat-plugin.version>0.18</maven.rat-plugin.version>
        <maven.refactor-first-plugin.version>0.9.0</maven.refactor-first-plugin.version>
        <maven.release-plugin.version>3.1.1</maven.release-plugin.version>
        <maven.site-plugin.version>3.22.0</maven.site-plugin.version>
        <maven.spotbugs-plugin.version>4.8.6.6</maven.spotbugs-plugin.version>
        <maven.version>3.9.9</maven.version>

        <!-- Docker -->
        <docker.jib-maven-plugin.version>3.5.2</docker.jib-maven-plugin.version>
        <docker.image.prefix>springcommunity</docker.image.prefix>

        <!-- SonarQube configuration -->
        <sonar.organization>spring-petclinic-rest</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>

    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Quarkus core / REST (Spring compatibility layer) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- REMOVED: quarkus-spring-web (was: spring-boot-starter-webmvc). All controllers are now JAX-RS resources; no Spring MVC annotation remains. -->
        <dependency>
            <!-- was: spring-boot-starter (DI): @Component, @Service, @Autowired, @Configuration, @Bean, @Value -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-spring-di</artifactId>
        </dependency>
        <dependency>
            <!-- was: spring-tx / @Transactional -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-spring-tx</artifactId>
        </dependency>
        <dependency>
            <!-- was: spring-boot-starter-data-jpa -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-spring-data-jpa</artifactId>
        </dependency>
        <!-- REMOVED: quarkus-spring-security (was: spring-boot-starter-security). @PreAuthorize is parked (see TODOs in the controllers) and the Spring Security config classes are excluded from compilation. -->
        <dependency>
            <!-- was: spring-boot-starter-validation -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- was: spring-boot-starter-actuator (health endpoint: /q/health) -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <!-- was: spring-boot-starter-actuator (metrics endpoint: /q/metrics, Prometheus format) -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <!-- was: springdoc-openapi-starter-webmvc-ui (OpenAPI at /q/openapi, Swagger UI at /q/swagger-ui) -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>

        <!-- TODO: Migration required - spring-boot-starter-cache removed: no @Cacheable/@CacheEvict/@EnableCaching usage
             exists in the sources (only a comment in ClinicServiceImpl). Add quarkus-spring-cache if caching is introduced. -->
        <!-- TODO: Migration required - spring-boot-starter-aspectj removed: CallMonitoringAspect (AspectJ + Spring JMX)
             has no Spring-compat equivalent in Quarkus. To be handled in the code module (CDI interceptor or removal). -->
        <!-- TODO: Migration required - spring-boot-starter-jdbc removed: the 'jdbc' repository implementations
             (repository/jdbc/**) depend on Spring JdbcTemplate, which has no Quarkus compat extension. -->

        <!-- Data stores and supporting libs -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!-- TODO: Migration required - org.hsqldb:hsqldb: Quarkus has no JDBC extension for HSQLDB, so the 'hsqldb'
             profile is not supported. Use H2, MySQL or PostgreSQL instead. -->
        <!-- TODO: Migration required - spring-boot-h2console: no Quarkus equivalent (H2 console is not exposed). -->
        <!-- TODO: Migration required - org.springframework.data:spring-data-jdbc-core (OneToManyResultSetExtractor, used only by
             the 'jdbc' repository implementations) has no Quarkus compat equivalent.
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jdbc-core</artifactId>
            <version>${spring-data-jdbc.version}</version>
        </dependency>
        -->

        <!-- Test libs -->
        <dependency>
            <!-- was: spring-boot-starter-test -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- was: spring-boot-starter-security-test (@WithMockUser -> @TestSecurity) -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Migration: @QuarkusTest runs the app in the QuarkusClassLoader, which the plain jacoco-maven-plugin agent does not
                 instrument. This extension records coverage itself (target/jacoco-quarkus.exec, report in target/jacoco-report). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Was transitively provided by spring-boot-starter-test; not part of the Quarkus test starters -->
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>

        <!-- JSON / XML / Serialization libs -->
        <!-- REMOVED: tools.jackson.core:jackson-core / jackson-databind (Jackson 3). Quarkus uses Jackson 2 via quarkus-rest-jackson;
             no source file imports tools.jackson. -->
        <dependency>
            <!-- Required by the generated API interfaces (springdoc documentation provider) -->
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${jackson-databind-nullable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
    </dependencies>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>${maven.jxr-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>${maven.project-info-reports-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>${maven.rat-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${maven.license-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>dependency-updates-report</report>
                            <report>plugin-updates-report</report>
                            <report>property-updates-report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
            <plugin>
                <groupId>org.hjug.refactorfirst.plugin</groupId>
                <artifactId>refactor-first-maven-plugin</artifactId>
                <version>${maven.refactor-first-plugin.version}</version>
                <!-- optional -->
                <configuration>
                    <showDetails>true</showDetails>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <reportSets>
                    <reportSet>
                        <id>report</id>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

    <build>
        <plugins>
            <!-- REMOVED: spring-boot-maven-plugin (incl. the build-info goal that fed Spring Boot Actuator's /info).
                 Replaced by quarkus-maven-plugin. Build info is not exposed by the Quarkus health endpoint. -->
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                            <goal>native-image-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${maven.jacoco-plugin.version}</version>
                <configuration>
                    <excludes>
                        <!-- Generated code -->
                        <exclude>**/org/springframework/samples/petclinic/rest/dto/**</exclude>
                        <exclude>**/org/springframework/samples/petclinic/rest/api/**</exclude>
                    </excludes>
                    <!-- Migration: classes loaded by the QuarkusClassLoader (@QuarkusTest) are recorded by the quarkus-jacoco extension;
                         the plain agent below only covers plain JUnit tests. Both write to the same file. -->
                    <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                    <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
                    <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
                    <append>true</append>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.66</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <!-- XML format for SonarCloud -->
                                <!-- https://docs.sonarsource.com/sonarqube-cloud/enriching/test-coverage/java-test-coverage/ -->
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${docker.jib-maven-plugin.version}</version>
                <configuration>
                    <to>
                        <image>docker.io/${docker.image.prefix}/${project.artifactId}</image>
                        <tags>
                            <tag>${project.version}</tag>
                            <tag>latest</tag>
                        </tags>
                    </to>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <!-- RELEASE_VERSION -->
                <version>${maven.openapi-generator-plugin.version}</version>
                <!-- /RELEASE_VERSION -->
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi.yml</inputSpec>
                            <generatorName>jaxrs-spec</generatorName>

                            <!-- Only enabling model and API generation -->
                            <modelNameSuffix>Dto</modelNameSuffix>
                            <apiPackage>org.springframework.samples.petclinic.rest.api</apiPackage>
                            <generateModels>true</generateModels>
                            <modelPackage>org.springframework.samples.petclinic.rest.dto</modelPackage>
                            <generateApis>true</generateApis>
                            <importMappings>
                                <importMapping>Nullable=org.jspecify.annotations.Nullable</importMapping>
                            </importMappings>
                            <configOptions>
                                <!-- MIGRATION: was generator 'spring' (Spring MVC interfaces, ignored by quarkus-spring-web).
                                     'jaxrs-spec' generates JAX-RS interfaces that Quarkus REST serves natively. -->
                                <!-- RestController implementation is provided by Petclinic developers -->
                                <interfaceOnly>true</interfaceOnly>
                                <!-- ApiUtil.java imports org.springframework.web.context.request.NativeWebRequest which
                                     does not exist on the Quarkus classpath. The file is unused with interfaceOnly=true
                                     and returnResponse=true (all interfaces return jakarta.ws.rs.core.Response). -->
                                <filesToSkip>ApiUtil.java</filesToSkip>
                                <returnResponse>true</returnResponse>
                                <!-- Generate API interfaces from OpenAPI tags -->
                                <useTags>true</useTags>
                                <useBeanValidation>true</useBeanValidation>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                <serializationLibrary>jackson</serializationLibrary>
                                <!-- jaxrs-spec defaults to Joda; use java.time like the original Spring generator -->
                                <dateLibrary>java8</dateLibrary>
                                <!-- jaxrs-spec emits a @JsonCreator constructor with required=true for readOnly properties (e.g. "id"),
                                     so request bodies without "id" (POST /specialties, /visits, ...) were rejected with 400 -->
                                <generateJsonCreator>false</generateJsonCreator>
                                <!-- jaxrs-spec defaults to src/gen/java; keep the path registered by build-helper below -->
                                <sourceFolder>src/main/java</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${maven.build-helper-plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>target/generated-sources/openapi/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler-plugin.version}</version>
                <configuration>
                    <!-- Required by Quarkus (CDI/REST parameter name discovery) -->
                    <parameters>true</parameters>
                    <!-- TODO: Migration required — the following Spring-only sources are parked (not compiled) because
                         they have no Quarkus equivalent in the Spring compatibility layer. See docs/quarkus-migration-decisions.md.
                         - repository/jdbc/**: Spring JdbcTemplate/NamedParameterJdbcTemplate/SimpleJdbcInsert (profile "jdbc")
                         - repository/springdatajpa/**: Spring Data JPA repositories (default profile in the original). The
                           quarkus-spring-data-jpa processor (3.40.1) cannot generate the custom save/delete methods nor handle the
                           two-level interface design (repository/<X>Repository + SpringData<X>Repository + *Override fragments).
                           The plain-JPA layer (repository/jpa/**, EntityManager based) is the active persistence layer instead.
                         - security/BasicAuthenticationConfig, DisableSecurityConfig: Spring Security HttpSecurity/SecurityFilterChain
                         - util/CallMonitoringAspect: Spring AOP + JMX (@ManagedResource) -->
                    <excludes>
                        <exclude>**/org/springframework/samples/petclinic/repository/jdbc/**</exclude>
                        <exclude>**/org/springframework/samples/petclinic/repository/springdatajpa/**</exclude>
                        <exclude>**/org/springframework/samples/petclinic/security/BasicAuthenticationConfig.java</exclude>
                        <exclude>**/org/springframework/samples/petclinic/security/DisableSecurityConfig.java</exclude>
                        <exclude>**/org/springframework/samples/petclinic/util/CallMonitoringAspect.java</exclude>
                    </excludes>
                    <testExcludes>
                        <!-- TODO: Migration required - tests for the parked Spring JDBC / Spring Data JPA layers and the Spring test config -->
                        <testExclude>**/service/clinicService/ClinicServiceH2JdbcTests.java</testExclude>
                        <testExclude>**/service/clinicService/ClinicServiceHsqlJdbcTests.java</testExclude>
                        <testExclude>**/service/clinicService/ClinicServiceSpringDataJpaTests.java</testExclude>
                        <testExclude>**/service/clinicService/ApplicationTestConfig.java</testExclude>
                        <testExclude>**/service/userService/UserServiceH2JdbcTests.java</testExclude>
                        <testExclude>**/service/userService/UserServiceHsqlJdbcTests.java</testExclude>
                        <testExclude>**/service/userService/UserServiceSpringDataJpaTests.java</testExclude>
                    </testExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.mapstruct</groupId>
                                    <artifactId>mapstruct-processor</artifactId>
                                    <version>${mapstruct.version}</version>
                                </path>
                            </annotationProcessorPaths>
                            <compilerArgs>
                                <compilerArg>
                                    -Amapstruct.suppressGeneratorTimestamp=true
                                </compilerArg>
                                <compilerArg>
                                    -Amapstruct.suppressGeneratorVersionInfoComment=true
                                </compilerArg>
                                <compilerArg>
                                    -Amapstruct.defaultComponentModel=jakarta-cdi
                                </compilerArg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <message>This build requires at least Java ${java.version}, update your JVM, and run the build again
                                    </message>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${maven.version}</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${maven.site-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
